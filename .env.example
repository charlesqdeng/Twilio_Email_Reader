# Email Reader - Environment Configuration Template
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and will never be committed

# Google OAuth Configuration
# Get these credentials from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Google Gemini API (Optional - can be configured in Settings UI)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API (Optional - can be configured in Settings UI)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Anthropic Claude API (Optional - can be configured in Settings UI)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=your-random-session-secret-change-in-production
NODE_ENV=development

# Note: AI API keys (OpenAI, Gemini, Anthropic) can be configured
# either here in .env OR through the Settings page in the app after logging in.
# Keys in .env will be used as defaults if not configured in Settings.

# ============================================================================
# Email Processing Configuration (Optional)
# ============================================================================

# Internal Tool Domains
# Comma-separated list of domains/tools to treat as internal notifications
# rather than customer emails. The app has sensible defaults, but you can
# override them here if needed.
# Example: INTERNAL_TOOL_DOMAINS=jira,github,slack,pagerduty
# INTERNAL_TOOL_DOMAINS=

# Customer Domains
# Comma-separated list of domains to ALWAYS treat as customers, even if they
# appear in the internal tools list. Useful if you work with companies like
# Twilio, GitHub, etc. as actual customers.
# Example: CUSTOMER_DOMAINS=twilio.com,github.com
# CUSTOMER_DOMAINS=

# Newsletter Domains
# Comma-separated list of newsletter/marketing domains to deprioritize
# Example: NEWSLETTER_DOMAINS=substack.com,beehiiv.com
# NEWSLETTER_DOMAINS=

# Notification Patterns
# Comma-separated patterns to identify automated emails
# Example: NOTIFICATION_PATTERNS=noreply,no-reply,notifications,automated
# NOTIFICATION_PATTERNS=

# Company Aliases
# JSON object mapping company name variations to a single canonical name
# Useful when the same customer has multiple domains or variations
# Example: COMPANY_ALIASES={"360smsapp":"360 Degree Cloud","360degreecloud":"360 Degree Cloud"}
# COMPANY_ALIASES=
